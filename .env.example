# Gateway
APPLICATION_ID=sample-app
UPSTREAM_URL=http://sample-app:4000
KAFKA_BROKERS=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379
FAIL_CLOSED=false
SAMPLE_APP_API_KEY=sample-app-secret
LOG_LEVEL=info
PORT=3000

# Analyzer
KAFKA_GROUP_ID=threat-analyzers
THREAT_TTL_SECONDS=300
CS_WINDOW_SECONDS=60
CS_MAX_IP_FAILURES=20
CS_MAX_USER_FAILURES=5
CS_MAX_DISTINCT_ACCOUNTS=10
CS_MAX_DISTINCT_IPS=8
BOLA_WINDOW_SECONDS=120
BOLA_MAX_DISTINCT_RESOURCES=50

# Sample App
JWT_SECRET=change-me-in-production
